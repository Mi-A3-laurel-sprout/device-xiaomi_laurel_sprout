<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>

    <!-- Color of the UDFPS pressed view -->
    <color name="config_udfpsColor">#ffffff</color>

    <!-- HBM type of UDFPS overlay.
            0 - GLOBAL HBM 
            1 - LOCAL HBM
    -->
    <integer name="config_udfps_hbm_type">0</integer>

    <!-- Trigger onFingerDown for action down events. This is a workaround for certain devices
         that have UDFPS delays without the commit present and should be false by default. -->
    <bool name="config_udfpsTriggerOnFingerDownForActionDown">true</bool>

    <!-- keyguard positioning -->
    <dimen name="keyguard_indication_margin_bottom">120dp</dimen>

    <!-- Padding for the lock icon on the keyguard. In pixels - should not scale with display size.
         (Inner space from radius of bg circle to amount of pixels)-->
    <dimen name="lock_icon_padding">30px</dimen>

    <!-- Pixel pitch of the device. um/px -->
    <item name="pixel_pitch" format="float" type="dimen">89.55</item>

    <!-- Udfps vendor code -->
    <integer name="config_udfpsVendorCode">22</integer>

    <!-- Whether to pulse onFingerDown actions instead
        of waking the screen while the screen is off or in lpm. -->
    <bool name="config_pulseOnFingerDown">true</bool>

    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Doze: does this device support STATE_DOZE_SUSPEND?  -->
    <bool name="doze_suspend_display_state_supported">true</bool>
</resources>
